# ==========================================================
# CheckDolar — Variables de entorno
# Copiá este archivo a ".env.local" y completá lo que necesites.
# Ninguna de estas keys se expone al navegador: todas se usan
# solo dentro de las API routes de Next.js (carpeta src/app/api).
# ==========================================================

# --- Dólar Argentina y monedas de la región (dolarapi.com) ---
# No requiere API key. Se puede pisar la URL base si algún día
# se migra a un proveedor propio o de pago.
DOLAR_API_BASE_URL=https://dolarapi.com

# --- Monedas internacionales (open.er-api.com) ---
# No requiere API key para el plan gratuito.
# Si preferís un proveedor con más precisión/soporte, se puede
# reemplazar por exchangerate-api.com o similar sin tocar el resto
# del código: solo hay que editar src/lib/services/currencyService.ts
CURRENCY_API_BASE_URL=https://open.er-api.com/v6

# --- Criptomonedas (CoinGecko) ---
# La API pública funciona sin key con límites de uso moderados.
# Si tenés una API key de CoinGecko (plan Demo/Pro), completala acá
# para aumentar el límite de requests y evitar errores 429.
COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=

# --- Mercados: MERVAL, acciones, índices internacionales ---
# Twelve Data (https://twelvedata.com) tiene un plan gratuito con
# API key. Sin esta key, la sección "Mercados" muestra un aviso de
# "Datos temporalmente no disponibles" en lugar de inventar valores.
# Obtené tu key gratuita en: https://twelvedata.com/pricing
TWELVE_DATA_API_KEY=

# --- Riesgo país / datos históricos Argentina (opcional) ---
# ArgentinaDatos (https://argentinadatos.com) es pública y sin key.
ARGENTINA_DATOS_BASE_URL=https://api.argentinadatos.com/v1

# --- Configuración de cache/actualización ---
# Segundos que el backend cachea cada fuente antes de volver a pedirla.
CACHE_TTL_DOLAR=60
CACHE_TTL_MONEDAS=120
CACHE_TTL_CRIPTO=45
CACHE_TTL_MERCADOS=90
